# Required for LLM, STT, and Vision features (set via tgcloud secrets or local env)
GEMINI_API_KEY=
# 32-byte hex or passphrase used for ChaCha20-Poly1305 BYOK key encryption at rest
MASTER_KEY=
# Optional Telegram webhook secret token
WEBHOOK_SECRET=

# Optional comma-separated Telegram user IDs
# Leave empty for open multi-tenant registration
ADMIN_IDS=
BETA_WHITELIST=

# Optional Mini App URL override
MINI_APP_URL=

# Default user/instance preferences (can also be configured in overlay/manifest.json)
APP_TIMEZONE=UTC
APP_BASE_CURRENCY=EUR
APP_SUMMARY_TIME=07:00
GEMINI_MODELS=

# Optional path to an external overlay directory (falls back to ./overlay or ./example/overlay)
OVERLAY_DIR=

# Telegram Serverless CLI deploy token (from BotFather -> Serverless -> CLI Access)
TGCLOUD_TOKEN=
