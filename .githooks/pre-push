#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

node scripts/check-leaks.mjs --git-history

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --source . --config .gitleaks.toml --redact --no-banner
else
  echo "check-leaks: gitleaks not installed locally; install via 'brew install gitleaks' for additional local secret scanning (CI enforces gitleaks on all pushes/PRs)."
fi
